# Kilimanjaro Web UI Environment Configuration
# Copy this file to .env and customize as needed

# API URL - defaults to http://localhost:8766 if not set
# Examples:
#   For production: API_URL=https://api.yourdomain.com
#   For development: API_URL=http://localhost:8766
#   For remote testing: API_URL=http://192.168.1.100:8766
API_URL=http://localhost:8766
