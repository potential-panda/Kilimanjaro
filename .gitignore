# Python bytecode, environments, and packaging
__pycache__/
*.pyc
.venv/
*.egg-info/

# cadence daemon runtime
.cadence.pid
.cadence.log*

# Regenerable scan diagnostics — OBI-age histograms (~12MB each). The scan's
# large per-combo diagnostics regenerate on the next `grid obi` run.
cycle/15_return_eval/**/age_hist/

# stage output runs (regenerable diagnostics; the ledger is the durable record)
cycle/13_signal_corr/*/
cycle/14_blend_corr/*/
cycle/15_return_eval/*/
cycle/16_calibration/*/

# Test and tool caches
.pytest_cache
.ruff_cache/

# Editor-local settings
.vscode/
.claude
